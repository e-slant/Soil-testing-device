<UserControl x:Class="smartAgriculture.Views.deepseek"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:smartAgriculture.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="300,10,120,20">
        <Grid.Background>
            <SolidColorBrush Color="#222b51"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"></RowDefinition>
            <RowDefinition Height="16*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="AI分析" FontSize="35" Foreground="White" HorizontalAlignment="Center" Grid.Row="0"></Label>
        <Button Content="开始分析" Foreground="#f28500" FontSize="18" Grid.Row="2" Margin="200 0 200 0" Click="Button_Click"/>
        <TextBlock Name="AIcontent" HorizontalAlignment="Center" Margin="0,34,0,0" Grid.Row="1" TextWrapping="Wrap" Foreground="White" VerticalAlignment="Top" Height="206" Width="320"/>

    </Grid>
</UserControl>
