<UserControl x:Class="smartAgriculture.Views.systemConfiger"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:smartAgriculture.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="120,100,120,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition  />
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <SolidColorBrush Color="AliceBlue"/>
        </Grid.Background>

        <Border BorderThickness="4" Margin="10,10,10,10" BorderBrush="blue" CornerRadius="2">
            <Grid >

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>



                <Label Content="串口配置："  FontSize="20" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <Label Content="串口号： " FontSize="16" VerticalAlignment="Center"/>
                    <!--<TextBox  x:Name="setPortName" Text=" 0" FontSize="16"   Width="150"
                           VerticalAlignment="Center"/>-->
                    <ComboBox x:Name="setPortName"  FontSize="16"   Width="150"
                           VerticalAlignment="Center">
            
                        </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="2">
                    <Label Content="波特率： " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"   Width="150" x:Name="setBaudRate"
                           VerticalAlignment="Center"/>
                    <!--<ComboBox SelectedIndex="0" FontSize="16"   Width="150" x:Name="setBaudRate"
                           VerticalAlignment="Center">
                        <ComboBoxItem Content="9600"/>
                        <ComboBoxItem Content="2400"/>
                        <ComboBoxItem Content="4800"/>
                        <ComboBoxItem  Content="19200"/>
                        <ComboBoxItem  Content="38400"/>
                        <ComboBoxItem  Content="57600"/>
                        <ComboBoxItem  Content="115200"/>
                    </ComboBox>-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="3">
                    <Label Content="校   验  :  " FontSize="16" VerticalAlignment="Center"/>
                    <!--<TextBox Text=" 0" FontSize="16"   Width="150" x:Name="setParity"
                           VerticalAlignment="Center"/>-->
                    <ComboBox SelectedIndex="0" Background="White"  FontSize="16"   Width="150" x:Name="setParity"
                           VerticalAlignment="Center">
                        <ComboBoxItem  Content="None"/>
                        <ComboBoxItem Content="Odd"/>
                        <ComboBoxItem Content="Even"/>
                        <ComboBoxItem Content="Mark"/>
                        <ComboBoxItem Content="Space"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="4">
                    <Label Content="停止位： " FontSize="16" VerticalAlignment="Center"/>

                    <ComboBox SelectedIndex="0" FontSize="16"   Width="150" x:Name="setStopBit"
                           VerticalAlignment="Center">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem  Content="1.5"/>
                        <ComboBoxItem  Content="2"/>
                        
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="5">
                    <Label Content="数据位： " FontSize="16" VerticalAlignment="Center"/>
                    <!--<TextBox Text=" 0" FontSize="16"   Width="150" x:Name="setDataBit"
                           VerticalAlignment="Center"/>-->
                    <ComboBox SelectedIndex="0" Background="White"  FontSize="16"   Width="150" x:Name="setDataBit"
                           VerticalAlignment="Center">
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem  Content="5"/>
                        <ComboBoxItem  Content="6"/>
                        <ComboBoxItem  Content="7"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="6">
                    <Label Width=" 20"/>
                    <Button x:Name="open" Click="open_Click"
                            Content="连 接" FontSize="20"  Height="30" />
                    <Label Width=" 80"/>
                    <Button x:Name="off" Click="off_Click"
                            Content="断 开" FontSize="20" Height="30" />
                </StackPanel>



            </Grid>
        </Border>

        <Border BorderThickness="4" Margin="10" Grid.Column="1" BorderBrush="blue" CornerRadius="2">
            <Grid Name="page">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="报警参数配置："  FontSize="20" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <Label Content="温度  上限： " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text="0" FontSize="16"  x:Name="TemperatrueUpperValue"
                           VerticalAlignment="Center" Width="200"/>
                    <Label Content="    温度  下限： " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="TemperatrueLowerValue"
                           VerticalAlignment="Center" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="2">
                    <Label Content="PH值 上限： " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="PhUpperValue"
                           VerticalAlignment="Center" Width="200"/>
                    <Label Content="    PH值 下限： " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="PhLowerValue"
                           VerticalAlignment="Center" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="3">
                    <Label Content="含水量上限:  " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="WaterUpperValue"
                           VerticalAlignment="Center" Width="200"/>
                    <Label Content="    含水量下限： " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="WaterLowerValue"
                           VerticalAlignment="Center" Width="200"/>
                </StackPanel>
                <!--<StackPanel Orientation="Horizontal" Grid.Row="4">
                    <Label Content="电导率上限：" FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="ConductivityUpperValue"
                           VerticalAlignment="Center" Width="200" PreviewTextInput="TextBox_PreviewTextInput"/>
                    <Label Content="    电导率下限： " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="ConductivityLowerValue"
                           VerticalAlignment="Center" Width="200"/>
                </StackPanel>-->
                <!--<StackPanel Orientation="Horizontal" Grid.Row="4">
                    <Label Content="室温上限：   " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="room_temperatureUpperValue"
                           VerticalAlignment="Center" Width="200"/>
                    <Label Content="    室温下限：    " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="room_temperatureLowerValue"
                           VerticalAlignment="Center" Width="200"/>
                </StackPanel>-->
                <StackPanel Orientation="Horizontal" Grid.Row="4">
                    <Label Content="氮上限：      " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="NitrogenUpperValue"
                           VerticalAlignment="Center" Width="200"/>
                    <Label Content="    氮下限：       " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="NitrogenLowerValue"
                           VerticalAlignment="Center" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="5">
                    <Label Content="磷上限：      " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="PhosphorusUpperValue"
                           VerticalAlignment="Center" Width="200"/>
                    <Label Content="    磷下限：       " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="PhosphorusLowerValue"
                           VerticalAlignment="Center" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="6">
                    <Label Content="钾上限：      " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="PotassiumUpperValue"
                           VerticalAlignment="Center" Width="200"/>
                    <Label Content="    钾下限：       " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Text=" 0" FontSize="16"  x:Name="PotassiumLowerValue"
                           VerticalAlignment="Center" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="7">
                    <Label Width=" 20"/>
                    <Button x:Name="sendConfig" 
                            Click="sendConfig_Click"
                            Margin="2,10,2,0" Content="传送配置" FontSize="20" Height="30" VerticalAlignment="Top" />

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
